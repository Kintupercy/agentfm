# ── AgentFM environment ──────────────────────────────────────────────
# Phase 1 (web demo) needs NOTHING below — `npm run demo` runs on the
# mock emitter with zero keys and zero call spend.

# ── Web app (apps/web) ───────────────────────────────────────────────
# Data source: "mock" (default, zero-spend demo) | "supabase" (Phase 2)
VITE_DATA_SOURCE=mock
# Supabase Realtime (Phase 2 — UI subscribes to the station channel)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Broadcast stream URL (Icecast mount). Empty = demo bed loop (/demo-bed.wav).
# Local stack: http://localhost:8000/agentfm   VPS: https://<domain>/stream
VITE_STREAM_URL=

# ── Deploy (Hostinger VPS, apps on the box) ──────────────────────────
HOSTINGER_API_TOKEN=
AGENTFM_VM_ID=
# public host: agentfm.srv<VM>.hstgr.cloud (free) or agentfm.live
DOMAIN=
# shared secret for cross-container internal calls (now-playing); 24+ chars
AGENTFM_INTERNAL_TOKEN=

# ── Broadcast engine (apps/audio) ────────────────────────────────────
ICECAST_SOURCE_PASSWORD=agentfm-dev
ICECAST_ADMIN_PASSWORD=agentfm-dev-admin
# station engine endpoint Liquidsoap POSTs now-playing JSON to (optional)
AGENTFM_NOW_PLAYING_URL=
# how often ingest.mjs polls AgentCall for new station-call recordings
AGENTFM_INGEST_POLL_MS=30000

# ── Station engine (apps/server, Phase 2) ────────────────────────────
PORT=8787
# public HTTPS base of this server (nginx) — enables webhook auto-registration
# and the host contextWebhook, e.g. https://agentfm.live/api
AGENTFM_PUBLIC_URL=
# start the show loop on boot (otherwise POST /internal/show/start)
SHOW_AUTOSTART=false
# seconds of bed/ads between calls
GAP_BETWEEN_CALLS_SECS=90
# write spoken TTS interstitials (cedar) here for Liquidsoap; empty = ticker only
AGENTFM_INTERSTITIALS_DIR=
# run the engine with a mock AgentCall client — zero keys, zero spend
AGENTFM_MOCK_AGENTCALL=false
# AgentCall — https://agentcall.co/api-keys
AGENTCALL_API_KEY=
AGENTCALL_API_URL=https://api.agentcall.co
# Webhook signing secret returned by POST /v1/webhooks (create_webhook)
AGENTCALL_WEBHOOK_SECRET=
# Shared secret WE generate for the host contextWebhook (min 16 chars)
CONTEXT_WEBHOOK_SECRET=
# Station number (the host's inbound-AI number, E.164) + its numberId
STATION_NUMBER=
STATION_NUMBER_ID=

# Supabase service role (backend only — NEVER in the web app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — show-running LLM only (rundowns, topics, recaps). Never call audio.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# ── Cost guards (mandatory) ──────────────────────────────────────────
# Hard halt: stops all outbound dials and disables inbound AI
KILL_SWITCH=false
# Orchestrator-enforced daily budget in USD (checked against GET /v1/usage)
DAILY_BUDGET_USD=25
# Max guest airtime per call (seconds) — passed as maxDurationSecs
GUEST_MAX_DURATION_SECS=120
# Max calls per show
SHOW_MAX_CALLS=12
# $/min per AI leg used for budget math (0.40 managed, 0.10 BYOK)
AI_VOICE_RATE_PER_MIN=0.40

# /etc/systemd/system/agentfm-liquidsoap.service
# sudo systemctl daemon-reload && sudo systemctl enable --now agentfm-liquidsoap
[Unit]
Description=AgentFM broadcast engine (Liquidsoap)
After=network.target icecast2.service
Wants=icecast2.service

[Service]
Type=simple
User=agentfm
Group=agentfm
Environment=AGENTFM_STATION_AUDIO=/srv/agentfm/audio/station
Environment=AGENTFM_QUEUE_DIR=/srv/agentfm/queue
Environment=AGENTFM_PLAYED_DIR=/srv/agentfm/played
Environment=AGENTFM_NOW_PLAYING_FILE=/srv/agentfm/now-playing.json
# station engine endpoint that relays now-playing onto Supabase Realtime:
Environment=AGENTFM_NOW_PLAYING_URL=http://127.0.0.1:8787/internal/now-playing
Environment=ICECAST_HOST=127.0.0.1
Environment=ICECAST_PORT=8000
EnvironmentFile=-/srv/agentfm/audio.env
ExecStart=/usr/bin/liquidsoap /srv/agentfm/station.liq
Restart=always
RestartSec=3
# logs: journalctl -u agentfm-liquidsoap -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
